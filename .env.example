# Réglages à renseigner dans Vercel > Project > Settings > Environment Variables
# (ou dans .env.local pour tester en local).

# --- Supabase (Project Settings > API Keys / Data API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé secrète : ne jamais la partager.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Resend (envoi des invitations, liens de connexion et alertes) ---
RESEND_API_KEY=re_...
# Expéditeur, sur ton domaine vérifié dans Resend
EMAIL_FROM="Aspyre Studio <contact@ton-domaine.fr>"

# --- Assistante IA « Ava » (facultatif) ---
# Clé API Anthropic (console.anthropic.com > API Keys). Sans elle, l'assistante n'apparaît pas.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Facultatif ---
# Adresse des alertes (par défaut : l'e-mail de ton compte admin)
# ADMIN_NOTIFICATION_EMAIL=
# Où arrivent les réponses des clients à tes e-mails (par défaut : l'e-mail de ton compte admin)
# EMAIL_REPLY_TO=
# Adresse publique du site (par défaut : détectée automatiquement)
# NEXT_PUBLIC_SITE_URL=
# Clé de chiffrement des accès clients (par défaut : dérivée de la clé secrète Supabase)
# CREDENTIALS_ENCRYPTION_KEY=
