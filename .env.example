# Copie ce fichier en .env.local (en local) ou renseigne ces variables
# dans Vercel > Project > Settings > Environment Variables.
# Valeurs disponibles dans Supabase > Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé secrète : ne jamais la partager ni la mettre dans du code côté client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Adresse publique de la plateforme (utilisée dans les e-mails d'invitation)
NEXT_PUBLIC_SITE_URL=https://ton-espace-client.vercel.app
